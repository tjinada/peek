<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Personal app talking to a homelab server: plain http (LAN IP, Tailscale IP) must work. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Peek connects to your Peek server on your home network.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Peek links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>peek</string>
			</array>
		</dict>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock Peek with Face ID.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save photos and videos from Peek to your library.</string>
</dict>
</plist>

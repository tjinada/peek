# Copy to .env and adjust. Everything is optional.

# Where the DB and media live. On Unraid set this to /data and map that to
# /mnt/user/appdata/peek in the container, or updates/recreates lose your sessions.
PEEK_DATA=/data

# Background refresh interval for followed accounts (hours, ±20% jitter)
PEEK_REFRESH_HOURS=4
# Opening a profile older than this triggers a fresh fetch (hours)
PEEK_PROFILE_TTL_HOURS=6
# Max new posts pulled per account per refresh (older ones: "Load older posts" on the profile)
PEEK_MAX_POSTS=24
# Pause between accounts during a refresh (seconds)
PEEK_DELAY_MIN=20
PEEK_DELAY_MAX=60

# Burner session. Turns on stories, highlights, the Reels tab, Instagram search,
# private-follow and age/region-restricted profiles. Leave blank to stay logged out.
# This only seeds it: you can also paste or replace the session on the Following page,
# and that one is kept until IG_SESSIONID here changes.
IG_USER=
IG_SESSIONID=
# Optional: the csrftoken cookie from the same browser (a random one is used if blank)
IG_CSRFTOKEN=

# Optional device cookies from the same browser session. They matter: without them
# app-side requests look device-less and Instagram refuses them more often.
IG_MID=
IG_DID=
IG_RUR=

# How the burner is spent.
#   off        never — restricted profiles fail, stories and highlights stay off
#   restricted only accounts flagged restricted or private, plus login-only features (default)
#   always     every request, including public profile and post fetches
PEEK_SESSION_POLICY=restricted

# Hard ceiling on burner operations per hour. Past it, restricted accounts queue and
# public fetching carries on anonymously. Raise only if you follow many restricted accounts.
PEEK_SESSION_BUDGET_HOUR=300

# One stories-tray request per cycle instead of one per account per refresh.
# Set to 0 to keep per-account story fetches (costs the burner more, but covers
# non-followed profiles too).
PEEK_STORIES_BATCHED=1

# These two need a login and are the most disposable features. 0 spends nothing on them.
PEEK_REELS_TAB=1
PEEK_IG_SEARCH=1

# Set this if the app is reachable from outside your LAN
PEEK_PASSWORD=